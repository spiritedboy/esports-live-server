{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build/debug",
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: build Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/debug",
        "--parallel"
      ],
      "dependsOn": "CMake: configure Debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CTest: Debug",
      "type": "process",
      "command": "ctest",
      "args": [
        "--test-dir",
        "${workspaceFolder}/build/debug",
        "--output-on-failure"
      ],
      "dependsOn": "CMake: build Debug",
      "problemMatcher": []
    }
  ]
}
