{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试完整直播（JSON配置）",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/esports_live",
      "args": [
        "--config",
        "${workspaceFolder}/config/server.json",
        "--output",
        "${workspaceFolder}/build/samples/config-debug.flv",
        "--record-prefix",
        "${workspaceFolder}/build/samples/config-debug-record",
        "--stats-file",
        "${workspaceFolder}/build/samples/config-debug-sync.csv",
        "--metrics-file",
        "${workspaceFolder}/build/samples/config-debug-metrics.csv"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CMake: build Debug",
      "setupCommands": [
        {
          "description": "启用 GDB 格式化输出",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "调试录像提取",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/esports_replay",
      "args": [
        "--input",
        "${workspaceFolder}/build/samples/config-debug-record-000000.mp4",
        "--output",
        "${workspaceFolder}/build/samples/debug-clip.mkv",
        "--start-ms",
        "200",
        "--duration-ms",
        "500"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CMake: build Debug",
      "setupCommands": [
        {
          "description": "启用 GDB 格式化输出",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "调试 FFmpeg 环境检测",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/ffmpeg_env_check",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CMake: build Debug",
      "setupCommands": [
        {
          "description": "启用 GDB 格式化输出",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
